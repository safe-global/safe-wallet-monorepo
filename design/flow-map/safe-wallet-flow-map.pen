":"number","value":6},"radius.app-card":{"type":"number","value":12},"radius.app-button":{"type":"number","value":8}},"children":[{"type":"frame","id":"f6y","name":"Cover · read me","x":0,"y":0,"width":1800,"gap":24,"padding":80,"fill":"$canvas.section","cornerRadius":32,"layout":"vertical","children":[{"type":"text","id":"t6l","content":"Safe{Wallet} — screen and flow map","fontFamily":"DM Sans","fontSize":64,"fontWeight":"700","fill":"$canvas.label","textGrowth":"auto"},{"type":"text","id":"t6m","content":"Generated from the safe-wallet-monorepo source code. 672 screens and states in 152 flows. Web screens are drawn twice: at desktop width (1440) and at a mobile viewport (390). The native mobile app (Expo) is drawn at 390.","fontFamily":"DM Sans","fontSize":22,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"fixed-width","width":"fill_container"},{"type":"text","id":"t6n","content":"How to read this file","fontFamily":"DM Sans","fontSize":28,"fontWeight":"700","fill":"$canvas.label","textGrowth":"auto"},{"type":"text","id":"t6o","content":"Each area has a \"Screens\" board and a \"Flows\" board. Every screen on a Screens board is a reusable component. Flow rows show instances of the same screens in order, so an edit to a screen shows up in every flow that uses it. Each screen keeps its route, its source file and designer notes in the layer context and metadata. Light and dark mode: switch the \"mode\" theme on any frame. Screens are mid-fidelity: layout, hierarchy and real copy from the code, not pixel-perfect visuals.","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"fixed-width","width":"fill_container"},{"type":"text","id":"t6p","content":"Areas","fontFamily":"DM Sans","fontSize":28,"fontWeight":"700","fill":"$canvas.label","textGrowth":"auto"},{"type":"text","id":"t6q","content":"• Web · Web onboarding & account access: 65 screens, 16 flows","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"auto"},{"type":"text","id":"t6r","content":"• Web · Web – Safe dashboard, assets & DeFi: 66 screens, 18 flows","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"auto"},{"type":"text","id":"t6s","content":"• Web · Web transactions: 68 screens, 12 flows","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"auto"},{"type":"text","id":"t6t","content":"• Web · Web – Safe settings, address book, settings transaction flows, recovery, Hypernative, nested Safes: 95 screens, 26 flows","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"auto"},{"type":"text","id":"t6u","content":"• Web · Spaces (Workspaces for teams): 107 screens, 25 flows","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"auto"},{"type":"text","id":"t6v","content":"• Web · Safe Apps, WalletConnect, misc pages & Transaction Builder: 80 screens, 12 flows","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"auto"},{"type":"text","id":"t6w","content":"• Mobile app · Mobile – app start, onboarding, import & home: 78 screens, 16 flows","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"auto"},{"type":"text","id":"t6x","content":"• Mobile app · Mobile – transactions, sign & execute, send, settings: 113 screens, 27 flows","fontFamily":"DM Sans","fontSize":20,"fontWeight":"400","fill":"$canvas.sublabel","textGrowth":"auto"}],"metadata":{"type":"board","column":"intro"}},{"type":"frame","id":"f6k","name":"Design system · components used by this map","x":2400,"y":0,"layout":"horizontal","gap":48,"padding":64,"alignItems":"start","fill":"$canvas.section","cornerRadius":32,"children":[{"type":"frame","id":"f70","width":560,"gap":24,"layout":"vertical","children":[{"type":"text","id":"t6z","content":"Web atoms","fontFamily":"DM