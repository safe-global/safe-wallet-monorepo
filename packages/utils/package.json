    "date-fns": "^4.1.0",
    "jest-fixed-jsdom": "^0.0.11",
    "ts-node": "^10.9.2"
  },
  "peerDependencies": {
    "@safe-global/protocol-kit": "^8.0.10",
    "@safe-global/store": "*",
    "@safe-global/types-kit": "^4.0.1"
  }
}
