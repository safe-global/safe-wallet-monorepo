{
  "private": true,
  "name": "@safe-global/design-system",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./eslint/*": "./eslint/*",
    "./*": "./src/*"
  },
  "scripts": {
    "css-vars": "npx -y tsx ./scripts/css-vars.ts > ./src/styles/brand-vars.css && prettier -w src/styles/brand-vars.css",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build --quiet",
    "test": "jest",
    "test:storybook": "cross-env NODE_ENV=test TZ=UTC jest --testMatch '**/*.stories.test.tsx' --testPathIgnorePatterns='/node_modules/'",
    "lint": "eslint src eslint",
    "lint:fix": "eslint src eslint --fix",
    "eslint": "eslint",
    "type-check": "tsc --noEmit",
    "prettier": "prettier --check . --config ../../.prettierrc --ignore-path ../../.prettierignore",
    "prettier:fix": "prettier --write . --config ../../.prettierrc --ignore-path ../../.prettierignore"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@safe-global/theme": "workspace:^",
    "@safe-global/utils": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.13.0",
    "react-resizable-panels": "^4.5.3",
    "shadcn": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@safe-global/test": "workspace:^",
    "@storybook/addon-designs": "^11.0.1",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-links": "^10.5.0",
    "@storybook/addon-themes": "^10.5.0",
    "@storybook/react": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^10.1.10",
    "jest": "^29.7.0",
    "jest-fixed-jsdom": "^0.0.10",
    "prettier": "^3.6.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.31.1",
    "vite": "8.0.16"
  }
}
