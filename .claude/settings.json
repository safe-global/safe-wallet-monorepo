{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/public-text-reminder.json\""
          },
          {
            "type": "command",
            "if": "Bash(gh pr edit *)",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/public-text-reminder.json\""
          },
          {
            "type": "command",
            "if": "Bash(gh pr comment *)",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/public-text-reminder.json\""
          },
          {
            "type": "command",
            "if": "Bash(gh pr review *)",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/public-text-reminder.json\""
          },
          {
            "type": "command",
            "if": "Bash(gh issue create *)",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/public-text-reminder.json\""
          },
          {
            "type": "command",
            "if": "Bash(gh issue edit *)",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/public-text-reminder.json\""
          },
          {
            "type": "command",
            "if": "Bash(gh issue comment *)",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/public-text-reminder.json\""
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request|add_issue_comment|add_reply_to_pull_request_comment|add_comment_to_pending_review|pull_request_review_write|issue_write)",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/public-text-reminder.json\""
          }
        ]
      }
    ]
  }
}
