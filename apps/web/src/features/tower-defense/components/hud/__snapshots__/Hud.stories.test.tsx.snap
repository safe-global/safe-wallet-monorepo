                style="margin-top: 6px;"
              >
                Drains 9/s for 3s
              </div>
            </span>
          </button>
        </div>
        <div
          class="toast toastInfo"
          role="status"
        >
          Wave 10: BOSS: Rug pull whale
        </div>
      </div>
    </div>
  </div>
</div>
`;
