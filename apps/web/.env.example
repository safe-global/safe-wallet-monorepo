NEXT_PUBLIC_INFURA_TOKEN=1234567890
NEXT_PUBLIC_WC_PROJECT_ID=0987654321
NEXT_PUBLIC_IS_OFFICIAL_HOST=false
NEXT_PUBLIC_PROD_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here
NEXT_PUBLIC_STAGING_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here, too

# --- Safenet read layer -------------------------------------------------------
# The singleton accepts only the pinned Gnosis deployment. Blank settings use its defaults.
# RPC overrides remain supported; each endpoint must pass chain and contract linkage checks.
NEXT_PUBLIC_SAFENET_CHAIN_ID=100
# Comma-separated, pinned Gnosis RPC endpoints for the read layer (rotated on failure).
NEXT_PUBLIC_SAFENET_RPC_URLS=https://rpc.gnosischain.com
# Safenet Consensus contract.
NEXT_PUBLIC_SAFENET_CONSENSUS_ADDRESS=0x98810887769db19A0Df9bf2f44E4998856fcb390
# FROSTCoordinator the epoch group keys are read from.
NEXT_PUBLIC_SAFENET_COORDINATOR_ADDRESS=0x2f88C123f34cB3c45482C5b04A0Faf00C6571F44
# Trusted Sentinel Oracle. Permissionless proposals can name untrusted contracts.
NEXT_PUBLIC_SAFENET_ORACLE_ADDRESSES=0x544F12bAd6FF72564abBc7eA6494A2a4BdD0DDD0
NEXT_PUBLIC_SAFENET_EXPLORER_URL=https://www.safe.dev/safenet