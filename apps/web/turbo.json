{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "type-check": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/ui/src/**", "$TURBO_ROOT$/packages/views/src/**"]
    },
    "lint": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/ui/eslint/**"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/theme/src/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/packages/views/src/**"
      ]
    }
  }
}
