PYTHONPATH=/app/
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY='test-secret-key-not-for-production'
DEBUG=0
DATABASE_URL=psql://postgres:postgres@postgres:5432/txs
ETH_L2_NETWORK=1
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=amqp://guest:guest@general-rabbitmq/txs-sepolia
DJANGO_ALLOWED_HOSTS="*"
FORCE_SCRIPT_NAME=/txs/
CSRF_TRUSTED_ORIGINS="http://localhost:8000"
EVENTS_QUEUE_URL=amqp://general-rabbitmq:5672
EVENTS_QUEUE_ASYNC_CONNECTION=True
EVENTS_QUEUE_EXCHANGE_NAME="safe-transaction-service-events"

# Test environment: immediate block confirmation (no reorg protection)
ETH_REORG_BLOCKS=0
ETH_EVENTS_BLOCKS_TO_REINDEX_AGAIN=0
RUN_MIGRATIONS=0
ENABLE_SAFE_SETUP_CONTRACTS=0
CELERYD_CONCURRENCY=20
CELERYD_PREFETCH_MULTIPLIER=1
