# Copy to .env.test and provide archive RPCs. Mainnet and Polygon are needed only for their profiles.
SEPOLIA_FORK_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY
FORK_RPC_URL_MAINNET=<Ethereum mainnet archive RPC URL>
FORK_RPC_URL_POLYGON=<Polygon archive RPC URL>

# Fork block/hash, chain ID and image digests default to test-images.env.
# Override ports when running more than one project on the same machine.
REVERSE_PROXY_PORT=8000
RPC_PORT=8545
